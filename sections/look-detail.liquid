{{ 'look-detail.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'looks.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<section class="look-detail">
  <div class="look-detail__inner">

    {% assign look_images = metaobject.images.value %}

    <div class="look-detail__layout">

      <div class="look-detail__visual">

        {% if look_images != blank %}
            <look-gallery class="look-detail__gallery-wrapper">

            <div class="look-detail__gallery" data-gallery>
                {% for image in look_images %}
                <div class="look-detail__slide">
                    {{ image
                    | image_url: width: 600
                    | image_tag:
                        loading: 'lazy',
                        alt: metaobject.title.value
                    }}
                </div>
                {% endfor %}
            </div>

            {% if look_images.size > 1 %}
                <button
                type="button"
                class="look-detail__gallery-button look-detail__gallery-button--prev"
                data-prev
                aria-label="Voir l’image précédente"
                >
                &lt;
                </button>

                <button
                type="button"
                class="look-detail__gallery-button look-detail__gallery-button--next"
                data-next
                aria-label="Voir l’image suivante"
                >
                &gt;
                </button>
            {% endif %}

            </look-gallery>
        {% endif %}

      </div>


      <div class="look-detail__content">

        <h1 class="look-detail__title">
          {{ metaobject.title.value }}
        </h1>

        {% if metaobject.subtitle.value != blank %}
          <div class="look-detail__subtitle">
            {{ metaobject.subtitle.value }}
          </div>
        {% endif %}

        {% assign look_products = metaobject.products.value %}

        {% if look_products != blank %}
            <look-shop-all>
                <div class="look-detail__products">
                    {% for product in look_products %}
                        <div class="look-detail__product">

                            {% if product.featured_image %}
                                <div class="look-detail__product-image">
                                {{ product.featured_image
                                    | image_url: width: 400
                                    | image_tag:
                                    loading: 'lazy',
                                    alt: product.title
                                }}
                                </div>
                            {% endif %}

                            <div class="look-detail__product-info">
                                <div class="look-detail__product-header">
                                    <h2 class="look-detail__product-title">
                                        {{ product.title }}
                                    </h2>

                                    <span class="look-detail__product-price">
                                        {{ product.price | money }}
                                    </span>
                                    
                                    {% render 'look-buy-button', product: product, section_id: section.id %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                    <button
                        type="button"
                        class="look-detail__shop-all"
                        data-add-all
                        >
                        Shop the look
                    </button>
                </div>
            </look-shop-all>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Looks Detail",
  "settings": [],
  "presets": [
    {
      "name": "Looks Detail"
    }
  ]
}
{% endschema %}